{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hyperion-gem-inclusions",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hyperion-inclusions-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "hyperion-inclusions-images"
    }
  ]
}
